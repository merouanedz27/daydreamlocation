# Copier vers .env.local et renseigner depuis le dashboard Supabase.
# Ne jamais committer .env.local.

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bouton « Connect » > Session pooler (port 5432).
# Migrations et outillage uniquement — jamais lu par l'application.
SUPABASE_DB_URL=

# Project Settings > API Keys > Secret keys (sb_secret_…)
# SERVEUR UNIQUEMENT — cette clé CONTOURNE RLS. Jamais de préfixe NEXT_PUBLIC_.
# Un seul usage : créer les comptes de l'équipe (src/lib/supabase/admin.ts).
# Absente, seul l'écran /equipe est en panne — le reste de l'app fonctionne.
SUPABASE_SECRET_KEY=
