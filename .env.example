# Copier vers .env.local et renseigner depuis le dashboard Supabase.
# Ne jamais committer .env.local.

# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Bouton « Connect » > Session pooler (port 5432).
# Migrations et outillage uniquement — jamais lu par l'application.
SUPABASE_DB_URL=

# Project Settings > API Keys > Secret keys (sb_secret_…)
# SERVEUR UNIQUEMENT — cette clé CONTOURNE RLS. Jamais de préfixe NEXT_PUBLIC_.
# Deux usages : créer les comptes de l'équipe, et lire les destinataires des
# e-mails de notification (src/lib/supabase/admin.ts, src/lib/email/notify.ts).
# Absente, l'écran /equipe et les e-mails sont en panne — le reste fonctionne.
SUPABASE_SECRET_KEY=

# --- E-mails de notification (src/lib/email/send.ts) — SERVEUR UNIQUEMENT ---
# Gratuit, sans domaine : Gmail + « mot de passe d'application »
#   (Compte Google > Sécurité > Validation en deux étapes > Mots de passe des applications).
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=adresse Gmail  SMTP_PASS=les 16 lettres
# Avec un domaine vérifié chez Resend : SMTP_HOST=smtp.resend.com, SMTP_USER=resend,
#   SMTP_PASS=la clé API (re_…), MAIL_FROM=DayDream <notifications@votre-domaine>.
# Absentes : aucun e-mail ne part, rien d'autre ne change.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Expéditeur affiché ; vide = SMTP_USER.  Ex. : DayDream Location <boutique@gmail.com>
MAIL_FROM=
# Adresse publique de l'app, pour les liens des e-mails (vide = domaine Vercel de production).
APP_URL=
# Secret de la tâche du soir (/api/cron/demain) — Vercel l'envoie de lui-même
# s'il est défini dans les variables du projet. Une longue chaîne aléatoire.
CRON_SECRET=
