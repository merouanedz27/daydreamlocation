{
  "name": "daydreamlocation",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.sw.json",
    "db:push": "supabase db push --db-url $SUPABASE_DB_URL --yes",
    "db:test": "node scripts/run-sql.mjs supabase/tests/availability.sql && node scripts/run-sql.mjs supabase/tests/rls.sql && node scripts/run-sql.mjs supabase/tests/dashboard.sql && node scripts/run-sql.mjs supabase/tests/payments.sql && node scripts/run-sql.mjs supabase/tests/team.sql && node scripts/run-sql.mjs supabase/tests/ensembles.sql",
    "db:advisors": "supabase db advisors --db-url $SUPABASE_DB_URL",
    "db:types": "node scripts/gen-types.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "verify": "npm run check:i18n && npm run test:refs && npm run test:ranges && npm run test:format && npm run typecheck && npm run lint",
    "test:refs": "node --experimental-strip-types scripts/test-stock-refs.mjs",
    "test:ranges": "node --experimental-strip-types scripts/test-rental-range.mjs",
    "test:format": "node --experimental-strip-types scripts/test-format.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.44.0",
    "next": "16.3.4",
    "next-intl": "^4.14.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "write-excel-file": "4.1.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@serwist/turbopack": "9.5.12",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "pg": "^8.23.0",
    "serwist": "9.5.12",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
